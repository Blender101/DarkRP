@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

@if ( !Player.IsValid() || Player.WantsHideHud ) 
    return;

<root>
    @if ( Player.IsArrested )
    {
        <div class="arrest-status hud-panel">
            <label class="title">Arrested</label>
            <label class="timer">Released in @ArrestSecondsRemaining seconds</label>
        </div>
    }

    <div class="player-card hud-panel">
        <div class="identity">
            <label class="name">@Player.DisplayName</label>
            <label class="job">@JobTitle</label>
        </div>

        <div class="stats">
            <div class="stat health">
                <Image class="icon" Texture=@HealthIcon />
                <label class="value">@DisplayHealth</label>
            </div>

            <div class="stat money">
                <label class="icon money-icon">$</label>
                <label class="value">@MoneyDisplay</label>
            </div>

            @if ( Player.Armour > 0 )
            {
                <div class="stat armour">
                    <Image class="icon" Texture=@ArmourIcon />
                    <label class="value">@DisplayArmour</label>
                </div>
            }
        </div>

        <div class="visa @VisaStateClass">
            <label class="dot"></label>
            <label class="label">@VisaStateLabel</label>
            @if ( !string.IsNullOrEmpty( VisaTimerLabel ) )
            {
                <label class="timer">@VisaTimerLabel</label>
            }
        </div>
    </div>

    @if ( Weapon.IsValid() && Weapon.UsesAmmo )
    {
        <div class="ammo hud-panel">
            @if ( WeaponConVars.UnlimitedAmmo )
            {
                <label class="value">∞</label>
            }
            else
            {
                <label class="value">@(Weapon.UsesClips ? Weapon.ClipContents.ToString() : (WeaponConVars.InfiniteReserves ? "∞" : Weapon.ReserveAmmo.ToString()))</label>
                @if ( Weapon.UsesClips )
                {
                    <label class="alternate">@(WeaponConVars.InfiniteReserves ? "∞" : Weapon.ReserveAmmo.ToString())</label>
                }
            }
            <Image class="icon" Texture=@AmmoIcon />
        </div>
    }
</root>

@code
{
    [Property] public Texture HealthIcon { get; set; }
    [Property] public Texture ArmourIcon { get; set; }
    [Property] public Texture AmmoIcon { get; set; }

    Player Player => Player.FindLocalPlayer();
    BaseWeapon Weapon => Player?.GetComponent<PlayerInventory>()?.ActiveWeapon as BaseWeapon;

    int DisplayHealth => (int)Player.Health;
    int DisplayArmour => (int)Player.Armour;
    int ArrestSecondsRemaining => Math.Max( 0, (int)MathF.Ceiling( Player.ArrestTimeRemaining ) );
    string MoneyDisplay => MoneyFormatter.FormatCompact( Player.Money );
    string JobTitle => string.IsNullOrWhiteSpace( Player.JobTitle ) ? "US Citizen" : Player.JobTitle;

    VisaComponent Visa => VisaComponent.For( Player );

    int VisaMinutesRemaining
    {
        get
        {
            if ( !Visa.IsValid() || !Visa.HasIssuedVisa )
                return 0;

            var remaining = Visa.ExpiryTime - DateTime.UtcNow;
            return remaining.Ticks <= 0 ? 0 : Math.Max( 0, (int)Math.Ceiling( remaining.TotalMinutes ) );
        }
    }

    string VisaStateClass
    {
        get
        {
            var visa = Visa;
            if ( !visa.IsValid() || !visa.HasIssuedVisa )
                return "missing";

            if ( visa.IsExpired )
                return "expired";

            return visa.IsFake ? "fake" : "real";
        }
    }

    string VisaStateLabel
    {
        get
        {
            var visa = Visa;
            if ( !visa.IsValid() || !visa.HasIssuedVisa )
                return "No Visa";

            if ( visa.IsExpired )
                return "Visa Expired";

            return visa.IsFake ? "Fake Visa" : "Visa";
        }
    }

    string VisaTimerLabel
    {
        get
        {
            var visa = Visa;
            if ( !visa.IsValid() || !visa.HasIssuedVisa || visa.IsExpired )
                return null;

            var minutes = VisaMinutesRemaining;
            return minutes <= 0 ? "<1m" : $"{minutes}m";
        }
    }

    bool IsSpawnMenuOpen()
    {
        var host = Game.ActiveScene.Get<SpawnMenuHost>();
        return host?.Panel?.HasClass( "open" ) ?? false;
    }

    protected override void OnUpdate()
    {
        Panel.SetClass( "spawnmenu-open", IsSpawnMenuOpen() );
    }

    protected override int BuildHash()
    {
        if ( !Player.IsValid() || Player.WantsHideHud ) return 0;

        var arrestHash = System.HashCode.Combine( Player.IsArrested, ArrestSecondsRemaining );
        var visaHash = System.HashCode.Combine( VisaStateClass, VisaMinutesRemaining );
        var weaponHash = System.HashCode.Combine( Weapon?.ClipContents, Weapon?.ReserveAmmo );
        return System.HashCode.Combine( Player.DisplayName, Player.Health, Player.Armour, Player.Money, Player.JobTitle, arrestHash, weaponHash, visaHash );
    }
}
